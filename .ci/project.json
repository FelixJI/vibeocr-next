{
  "schema_version": 1,
  "project": {
    "component": "next",
    "repository": "FelixJI/vibeocr-next"
  },
  "ci": {
    "bootstrap": [
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "python-bootstrap",
        "--timeout-seconds",
        "300",
        "--",
        "uv",
        "sync",
        "--frozen"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "web-bootstrap",
        "--timeout-seconds",
        "300",
        "--",
        "npm",
        "ci",
        "--prefix",
        "src/dotnet/VibeOCR.App/WebAssets"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "windows-runtime-bootstrap",
        "--timeout-seconds",
        "420",
        "--",
        "pwsh",
        "-File",
        "scripts/install_windows_app_runtime.ps1"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "velopack-tool-restore",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "tool",
        "restore"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "platform-restore",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "restore",
        "tests/dotnet/VibeOCR.Platform.Tests/VibeOCR.Platform.Tests.csproj",
        "--locked-mode"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "app-restore",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "restore",
        "tests/dotnet/VibeOCR.App.Tests/VibeOCR.App.Tests.csproj",
        "--locked-mode"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "contracts-restore",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "restore",
        "tests/dotnet/VibeOCR.Contracts.Tests/VibeOCR.Contracts.Tests.csproj",
        "--locked-mode"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "runtime-client-restore",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "restore",
        "tests/dotnet/VibeOCR.Runtime.Client.Tests/VibeOCR.Runtime.Client.Tests.csproj",
        "--locked-mode"
      ]
    ],
    "quality": [
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "quality",
        "--timeout-seconds",
        "480",
        "--",
        "uv",
        "run",
        "--frozen",
        "python",
        "scripts/check_quality.py"
      ]
    ],
    "e2e": [
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "platform-tests",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "test",
        "--project",
        "tests/dotnet/VibeOCR.Platform.Tests/VibeOCR.Platform.Tests.csproj",
        "-c",
        "Release",
        "--no-restore",
        "--hangdump",
        "--hangdump-timeout",
        "2m",
        "--hangdump-type",
        "None"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "app-tests",
        "--timeout-seconds",
        "300",
        "--",
        "pwsh",
        "-File",
        "scripts/test_app_ci.ps1"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "contracts-tests",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "test",
        "--project",
        "tests/dotnet/VibeOCR.Contracts.Tests/VibeOCR.Contracts.Tests.csproj",
        "-c",
        "Release",
        "--no-restore"
      ],
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "runtime-client-tests",
        "--timeout-seconds",
        "300",
        "--",
        "dotnet",
        "test",
        "--project",
        "tests/dotnet/VibeOCR.Runtime.Client.Tests/VibeOCR.Runtime.Client.Tests.csproj",
        "-c",
        "Release",
        "--no-restore"
      ]
    ],
    "release_build": [
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "release-build",
        "--timeout-seconds",
        "600",
        "--",
        "pwsh",
        "-File",
        "scripts/build-release.ps1"
      ]
    ],
    "release_smoke": [
      [
        "python",
        "scripts/run_ci_command.py",
        "--label",
        "release-smoke",
        "--timeout-seconds",
        "180",
        "--",
        "uv",
        "run",
        "--frozen",
        "python",
        "scripts/release_smoke.py"
      ]
    ]
  },
  "release": {
    "version_sources": [
      {
        "kind": "json",
        "path": "repository.json",
        "key": "version"
      },
      {
        "kind": "xml",
        "path": "src/dotnet/VibeOCR.App/VibeOCR.App.csproj",
        "key": "Version"
      }
    ],
    "generated_commands": [
      [
        "python",
        "scripts/sync_version.py",
        "--version",
        "{version}"
      ]
    ],
    "required_assets": [
      "VibeOCRNext-*-full.nupkg",
      "VibeOCRNext-*-delta.nupkg",
      "VibeOCRNext-v{version}-win-x64.zip",
      "releases.win.json",
      "product-identity.json",
      "SBOM.spdx.json"
    ],
    "identity_asset": "product-identity.json",
    "mirrors": [
      {
        "name": "gitee",
        "url_env": "GITEE_URL",
        "user_env": "GITEE_USER",
        "token_env": "GITEE_TOKEN",
        "user": "git"
      },
      {
        "name": "cnb",
        "url_env": "CNB_URL",
        "token_env": "CNB_TOKEN",
        "user": "git"
      }
    ]
  }
}
