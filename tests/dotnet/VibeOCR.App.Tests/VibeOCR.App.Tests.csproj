<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>VibeOCR.App.Tests</RootNamespace>
    <AssemblyName>VibeOCR.App.Tests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../../src/dotnet/VibeOCR.App/VibeOCR.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- #213: independent decode fixtures generated by
         scripts/generate_code_decode_fixtures.py (qrcode[pil]/python-barcode). -->
    <None Include="fixtures/codes/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
