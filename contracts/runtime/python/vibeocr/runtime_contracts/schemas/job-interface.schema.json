{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeocr/protocol/v2/job-interface.schema.json",
  "title": "VibeOCR v2 Deep Job Interface",
  "$defs": {
    "MineruTierId": {
      "type": "string",
      "enum": ["flash", "basic", "standard", "advanced"]
    },
    "MineruOcrMode": {
      "type": "string",
      "enum": ["auto", "txt", "ocr"]
    },
    "MineruConfig": {
      "type": "object",
      "required": ["tier"],
      "additionalProperties": false,
      "properties": {
        "tier": {"$ref": "#/$defs/MineruTierId"},
        "ocr_mode": {"$ref": "#/$defs/MineruOcrMode"},
        "page_range": {
          "type": "string",
          "pattern": "^(all|r?[1-9][0-9]*(-r?[1-9][0-9]*)?(,r?[1-9][0-9]*(-r?[1-9][0-9]*)?)*)$(?![\\s\\S])"
        },
        "language": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$(?![\\s\\S])"}
      }
    },
    "PipelineSelection": {
      "type": "object",
      "required": ["pipeline_id", "options_version", "options"],
      "additionalProperties": false,
      "properties": {
        "pipeline_id": {
          "type": "string",
          "enum": [
            "OCR",
            "PP-StructureV3",
            "MinerU",
            "PaddleOCR-VL",
            "TABLE_RECOGNITION",
            "FORMULA_RECOGNITION"
          ]
        },
        "options_version": {"type": "integer", "const": 1},
        "options": {"type": "object"},
        "mineru": {"$ref": "#/$defs/MineruConfig"}
      }
    },
    "SubmitItem": {
      "type": "object",
      "required": ["client_item_key", "ordinal", "display_name", "source"],
      "additionalProperties": false,
      "properties": {
        "client_item_key": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 0},
        "display_name": {"type": "string"},
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "attachment"],
              "additionalProperties": false,
              "properties": {
                "type": {"const": "upload.v1"},
                "attachment": {"type": "string", "minLength": 1}
              }
            },
            {
              "type": "object",
              "required": ["type", "session_id", "session_revision", "page_index"],
              "additionalProperties": false,
              "properties": {
                "type": {"const": "pdf_page.v1"},
                "session_id": {"type": "string", "minLength": 1},
                "session_revision": {"type": "string", "minLength": 1},
                "page_index": {"type": "integer", "minimum": 0}
              }
            }
          ]
        }
      }
    },
    "SubmitRequest": {
      "type": "object",
      "required": [
        "schema_version",
        "request_id",
        "kind",
        "priority",
        "pipeline",
        "items",
        "parameters"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {"type": "integer", "const": 2},
        "request_id": {"type": "string", "minLength": 1},
        "kind": {
          "type": "string",
          "enum": ["recognition", "pdf_ocr", "mineru_parse"]
        },
        "priority": {
          "type": "string",
          "enum": ["interactive", "background"]
        },
        "pipeline": {"$ref": "#/$defs/PipelineSelection"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/SubmitItem"}
        },
        "parameters": {"type": "object"}
      }
    },
    "ItemOutcome": {
      "type": "object",
      "required": [
        "item_id",
        "state",
        "attempt",
        "payload_type",
        "payload",
        "error_code",
        "error_detail"
      ],
      "additionalProperties": false,
      "properties": {
        "item_id": {"type": "string"},
        "state": {
          "type": "string",
          "enum": ["succeeded", "failed", "cancelled"]
        },
        "attempt": {"type": "integer", "minimum": 0},
        "payload_type": {"type": ["string", "null"]},
        "payload": {"type": ["object", "null"]},
        "error_code": {"type": ["string", "null"]},
        "error_detail": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "succeeded"}}},
          "then": {
            "properties": {
              "payload_type": {"type": "string", "minLength": 1},
              "payload": {"type": "object"},
              "error_code": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "payload_type": {"type": "null"},
              "payload": {"type": "null"},
              "error_code": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "JobCommand": {
      "type": "object",
      "required": [
        "command_id",
        "kind",
        "job_id",
        "item_ids",
        "priority_override"
      ],
      "additionalProperties": false,
      "properties": {
        "command_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["cancel", "retry", "forget"]},
        "job_id": {"type": "string", "minLength": 1},
        "item_ids": {"type": "array", "items": {"type": "string"}},
        "priority_override": {
          "type": ["string", "null"],
          "enum": ["interactive", "background", null]
        }
      }
    }
  }
}
