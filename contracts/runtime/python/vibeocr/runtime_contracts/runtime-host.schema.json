{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeocr/protocol/v2/runtime-host.schema.json",
  "title": "VibeOCR Runtime Host Control Protocol v2",
  "description": "Authoritative request and response envelopes for the one-shot Runtime Host JSON CLI.",
  "oneOf": [
    {
      "$ref": "#/$defs/ManagedEnvironmentRequest"
    },
    {
      "$ref": "#/$defs/ManagedEnvironmentResponse"
    }
  ],
  "$defs": {
    "Accelerator": {
      "type": "string",
      "enum": [
        "cpu",
        "nvidia_cuda"
      ]
    },
    "ComponentVariantCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variants"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ComponentVariantDescriptor"
          }
        }
      }
    },
    "ComponentVariantDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "accelerator",
        "component_id"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "accelerator": {
          "$ref": "#/$defs/Accelerator"
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DownloadSourceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DownloadSourceDescriptor"
          }
        }
      }
    },
    "DownloadSourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "endpoint"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/DownloadSourceKind"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DownloadSourceKind": {
      "type": "string",
      "description": "Open source-kind identifier. package_index selects a dependency package index; model_registry selects an upstream model-source preference that the Backend may encode for native engine downloaders. This preference does not make VibeOCR responsible for model files, downloads, caches, validation or repair. paddleocr_model_registry and mineru_model_registry independently select native engine preferences; model_registry is a legacy shared preference. Clients preserve unknown response values and only offer selection UI for kinds they understand.",
      "x-vibeocr-known-values": [
        "package_index",
        "model_registry",
        "paddleocr_model_registry",
        "mineru_model_registry"
      ]
    },
    "ExecutionPipelineId": {
      "type": "string",
      "enum": [
        "OCR",
        "PP-StructureV3",
        "MinerU",
        "PaddleOCR-VL",
        "TABLE_RECOGNITION",
        "FORMULA_RECOGNITION"
      ]
    },
    "ManagedEnvironmentRequest": {
      "type": "object",
      "description": "Frozen manager operations for named, isolated Python environments. The interpreter and dependency closure ship prebuilt with the product (PR2): installation transactions are retired and initialize_default only registers the bundled product environment. Production prepare/commit requires --environment-switch-control to hold the target operation lock across Supervisor startup and stdin commit/abort. Unguarded switching fails closed. Cleanup confirms explicit selected items against fresh ownership and references.",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_kind",
        "product_root",
        "component_lock",
        "runtime_manifest",
        "action"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "request_kind": {
          "const": "environment"
        },
        "product_root": {
          "type": "string",
          "minLength": 1
        },
        "component_lock": {
          "type": "string",
          "minLength": 1
        },
        "runtime_manifest": {
          "type": "string",
          "minLength": 1
        },
        "layout_manifest": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "list",
            "initialize_default",
            "set_sources",
            "prepare_switch",
            "commit_switch",
            "delete",
            "preview_cleanup",
            "run_cleanup"
          ]
        },
        "environment_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "Target environment id. Null (or absent where the action allows it) addresses the global source defaults and is only legal for set_sources."
        },
        "device": {
          "type": "string",
          "enum": [
            "cpu",
            "directml"
          ],
          "description": "prepare_switch only: desired execution device, independent of the installed closure. The CUDA variant is retired; DirectML is the only GPU backend."
        },
        "model_source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "set_sources only: model_registry source id to persist, or null to clear that kind. Model sources are a preference projected to engine-owned native downloaders; actual endpoints stay unknown."
        },
        "paddleocr_model_source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "set_sources only: independent PaddleOCR preference; null clears this engine override, absent preserves it."
        },
        "mineru_model_source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "set_sources only: independent MinerU preference; null clears this engine override, absent preserves it."
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "description": "run_cleanup only: explicit selectable item ids from the frozen preview."
        },
        "prepared": {
          "type": "object"
        },
        "started_health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "port",
            "instance_id"
          ],
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "instance_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ManagedEnvironmentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "response_kind",
        "action",
        "result"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "response_kind": {
          "const": "environment"
        },
        "action": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      }
    },
    "MineruConfigCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_tier",
        "tiers",
        "languages"
      ],
      "properties": {
        "default_tier": {
          "$ref": "#/$defs/MineruTierId"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/MineruTierDescriptor"
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "MineruTierAvailability": {
      "type": "string",
      "enum": [
        "ready",
        "preparation_required",
        "unavailable"
      ]
    },
    "MineruTierDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "availability",
        "reason_code"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/MineruTierId"
        },
        "availability": {
          "$ref": "#/$defs/MineruTierAvailability"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "MineruTierId": {
      "type": "string",
      "enum": [
        "flash",
        "basic",
        "standard",
        "advanced"
      ]
    },
    "OcrEngineAvailability": {
      "type": "string",
      "enum": [
        "ready",
        "preparation_required",
        "unavailable"
      ]
    },
    "OcrEngineCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engines"
      ],
      "properties": {
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/OcrEngineDescriptor"
          }
        }
      }
    },
    "OcrEngineDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "availability",
        "included_in_base",
        "reason_code",
        "required_component"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/OcrEngineId"
        },
        "availability": {
          "$ref": "#/$defs/OcrEngineAvailability"
        },
        "included_in_base": {
          "type": "boolean"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "required_component": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "OcrEngineId": {
      "type": "string",
      "enum": [
        "rapidocr",
        "windows",
        "paddleocr"
      ]
    },
    "ProgressSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "current"
      ],
      "properties": {
        "unit": {
          "$ref": "#/$defs/ProgressUnit"
        },
        "current": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "estimated_remaining_seconds": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "estimated_remaining_seconds"
            ]
          },
          "then": {
            "required": [
              "total"
            ],
            "properties": {
              "unit": {
                "enum": [
                  "items",
                  "bytes"
                ]
              },
              "total": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "ProgressUnit": {
      "type": "string",
      "enum": [
        "steps",
        "items",
        "bytes"
      ]
    },
    "RecognitionModeAvailability": {
      "type": "string",
      "enum": [
        "ready",
        "preparation_required",
        "unavailable"
      ]
    },
    "RecognitionModeCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/RecognitionModeDescriptor"
          }
        }
      }
    },
    "RecognitionModeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "pipeline_id",
        "engine",
        "provisioning",
        "availability",
        "reason_code",
        "required_component",
        "supported_options",
        "lifecycle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/RecognitionModeId"
        },
        "family": {
          "$ref": "#/$defs/RecognitionModeFamily"
        },
        "pipeline_id": {
          "$ref": "#/$defs/ExecutionPipelineId"
        },
        "engine": {
          "anyOf": [
            {
              "$ref": "#/$defs/OcrEngineId"
            },
            {
              "type": "null"
            }
          ]
        },
        "provisioning": {
          "$ref": "#/$defs/RecognitionModeProvisioning"
        },
        "availability": {
          "$ref": "#/$defs/RecognitionModeAvailability"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "required_component": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "supported_options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle": {
          "$ref": "#/$defs/RecognitionModeLifecycle"
        }
      }
    },
    "RecognitionModeFamily": {
      "type": "string",
      "enum": [
        "text",
        "document",
        "specialized"
      ]
    },
    "RecognitionModeId": {
      "type": "string",
      "enum": [
        "rapid_text",
        "windows_text",
        "paddle_text",
        "paddle_structure",
        "paddle_document_vl",
        "mineru_document",
        "paddle_table",
        "paddle_formula"
      ]
    },
    "RecognitionModeLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "supports_preload",
        "supports_ttl",
        "supports_pinning",
        "supports_release"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/RecognitionModeLifecycleKind"
        },
        "supports_preload": {
          "type": "boolean"
        },
        "supports_ttl": {
          "type": "boolean"
        },
        "supports_pinning": {
          "type": "boolean"
        },
        "supports_release": {
          "type": "boolean"
        }
      }
    },
    "RecognitionModeLifecycleKind": {
      "type": "string",
      "enum": [
        "unmanaged",
        "model_residency",
        "process_keep_alive"
      ]
    },
    "RecognitionModeProvisioning": {
      "type": "string",
      "enum": [
        "base_runtime",
        "operating_system",
        "advanced_component"
      ]
    }
  }
}
