{
  "name": "vibeocr-web-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.7.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format:check": "prettier --check \"src/{app,bridge,components,features,layout,styles,test,theme}/**/*.{ts,tsx,css}\" src/main.tsx \"*.{json,js,ts}\" index.html",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test ../../../../tests/web/*.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.5",
    "@fluentui/react-icons": "2.0.335",
    "@griffel/react": "1.7.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
