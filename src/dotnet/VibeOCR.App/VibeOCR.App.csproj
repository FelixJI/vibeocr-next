<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.9.0</Version>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VibeOCR.App</RootNamespace>
    <AssemblyName>VibeOCR.WinUI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>false</WindowsAppSdkSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/brand/generated/vibeocr.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- #321 F1：发布模式由显式构建属性选择（build-release.ps1 传入），
         开发/CI 默认非产品；不用 DEBUG/profile 判定。 -->
    <VibeOCRProductWebView2>false</VibeOCRProductWebView2>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VibeOCRProductWebView2)' == 'true'">
    <DefineConstants>$(DefineConstants);VIBEOCR_PRODUCT_WEBVIEW2</DefineConstants>
    <!-- #321 F6：自包含 apphost 只在应用目录内搜索 .NET，不读注册表/全局。 -->
    <AppHostDotNetSearch>AppLocal</AppHostDotNetSearch>
  </PropertyGroup>
  <!-- #321 F1：从 config/runtime/webview2-runtime.lock.json 生成锁版本常量，
       不存在第二处手写 pin；生成器失败即 fail closed。 -->
  <Target Name="GenerateWebView2LockVersion"
          BeforeTargets="PrepareForBuild"
          Condition="'$(VibeOCRProductWebView2)' == 'true'">
    <Exec Command="uv run --no-sync python &quot;$(MSBuildThisFileDirectory)..\..\..\scripts\generate_webview2_lock_version.py&quot; --output &quot;$(IntermediateOutputPath)WebView2LockVersion.g.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WebView2LockVersion.g.cs" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="ZXing.Net" />
    <ProjectReference Include="../VibeOCR.Platform/VibeOCR.Platform.csproj" />
    <ProjectReference Include="../VibeOCR.Contracts/VibeOCR.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="WebAssets\dist\**\*"
             Link="WebAssets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VibeOCR.App.Tests" />
  </ItemGroup>
  <!--
    Windows App SDK writes compiled XAML and the PRI beside TargetPath, but
    `dotnet publish -o` does not include them for this unpackaged WinUI app.
    Without these files the published EXE starts and then crashes in
    MainWindow.InitializeComponent with XamlParseException.
  -->
  <Target Name="CopyCompiledWinUIResourcesToPublish"
          AfterTargets="Publish">
    <ItemGroup>
      <_CompiledWinUIResource Include="$(TargetDir)**\*.xbf" />
      <_CompiledWinUIResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="'@(_CompiledWinUIResource)' == ''"
           Text="No compiled WinUI XBF/PRI resources were produced." />
    <Copy SourceFiles="@(_CompiledWinUIResource)"
          DestinationFiles="@(_CompiledWinUIResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
