<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.4.1</Version>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VibeOCR.App</RootNamespace>
    <AssemblyName>VibeOCR.WinUI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>false</WindowsAppSdkSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../../assets/brand/generated/vibeocr.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="VibeOCR.Runtime.Contracts" />
    <ProjectReference Include="../VibeOCR.Platform/VibeOCR.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="WebAssets\dist\**\*"
             Link="WebAssets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VibeOCR.App.Tests" />
  </ItemGroup>
  <!--
    Windows App SDK writes compiled XAML and the PRI beside TargetPath, but
    `dotnet publish -o` does not include them for this unpackaged WinUI app.
    Without these files the published EXE starts and then crashes in
    MainWindow.InitializeComponent with XamlParseException.
  -->
  <Target Name="CopyCompiledWinUIResourcesToPublish"
          AfterTargets="Publish">
    <ItemGroup>
      <_CompiledWinUIResource Include="$(TargetDir)**\*.xbf" />
      <_CompiledWinUIResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Error Condition="'@(_CompiledWinUIResource)' == ''"
           Text="No compiled WinUI XBF/PRI resources were produced." />
    <Copy SourceFiles="@(_CompiledWinUIResource)"
          DestinationFiles="@(_CompiledWinUIResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
