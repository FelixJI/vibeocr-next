<Page
    x:Class="VibeOCR.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="32" Spacing="16">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="诊断与修复" />
            <TextBlock Text="旁路配置" />
            <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.Profile}" />
            <TextBlock Text="版本" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="App" />
                <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.AppVersion}" />
                <TextBlock Text="Supervisor 实例" />
                <TextBlock FontFamily="Consolas" Text="{x:Bind ViewModel.SupervisorInstanceId, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="Supervisor 状态" />
            <TextBlock FontSize="20" Text="{x:Bind ViewModel.SupervisorStatus, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ProtocolStatus, Mode=OneWay}" />
            <TextBlock FontWeight="SemiBold" Text="运行时" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Prerequisites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Kind}" />
                            <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" />
                            <Button
                                Grid.Column="2"
                                Click="OnRepairClicked"
                                Content="打开修复入口"
                                Tag="{Binding Kind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock FontWeight="SemiBold" Text="启动里程碑 T0–T6" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Milestones}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Width="32" FontFamily="Consolas" Text="{Binding Name}" />
                            <TextBlock FontFamily="Consolas" Text="{Binding ElapsedMilliseconds}" />
                            <TextBlock Text="ms" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Click="OnExportClicked" Content="导出脱敏诊断" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ExportStatus, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
