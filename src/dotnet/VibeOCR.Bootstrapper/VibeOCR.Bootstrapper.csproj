<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VibeOCR.Bootstrapper</RootNamespace>
    <AssemblyName>VibeOCR.Bootstrapper</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>../../../assets/brand/generated/vibeocr.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../VibeOCR.ProductLayout.Shared/DotNetRuntimeProbe.cs" Link="ProductLayout/DotNetRuntimeProbe.cs" />
    <Compile Include="../VibeOCR.ProductLayout.Shared/ProductLayout.cs"
             Link="ProductLayout/ProductLayout.cs" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <Target Name="GenerateWebView2LockVersion" BeforeTargets="PrepareForBuild">
    <Exec Command="uv run --no-sync python &quot;$(MSBuildThisFileDirectory)..\..\..\scripts\generate_webview2_lock_version.py&quot; --output &quot;$(IntermediateOutputPath)WebView2LockVersion.g.cs&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WebView2LockVersion.g.cs" />
    </ItemGroup>
  </Target>
</Project>
