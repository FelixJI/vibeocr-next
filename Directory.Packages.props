    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
  </ItemGroup>
</Project>
